# Copy to .env and fill in — .env is gitignored.

# -----------------------------------------------------------------------------
# MySQL (read by docker-compose.yml)
# -----------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE={{PROJECT_NAME}}
MYSQL_USER=fivem
MYSQL_PASSWORD=fivem123
MYSQL_HOST_PORT=3307

# -----------------------------------------------------------------------------
# Database connection string (read by the framework at bootstrap)
# Keep in sync with the values above. `mysql` is the docker-compose service
# hostname — when running outside Docker, change to `localhost:3307`.
# -----------------------------------------------------------------------------
MYSQL_CONNECTION_STRING=mysql://fivem:fivem123@mysql:3306/{{PROJECT_NAME}}

# -----------------------------------------------------------------------------
# Discord webhooks (optional — referenced by framework.config.yaml via ${VAR})
# -----------------------------------------------------------------------------
DISCORD_FRAMEWORK_WEBHOOK=
DISCORD_TESTING_WEBHOOK=
DISCORD_TESTING_MENTION=
