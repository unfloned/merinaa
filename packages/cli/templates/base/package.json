{
    "name": "{{PROJECT_NAME}}",
    "version": "0.1.0",
    "private": true,
    "description": "{{PROJECT_DESCRIPTION}}",
    "scripts": {
        "postinstall": "npx deepkit-type-install || true",
        "build": "node scripts/build.js",
        "dev": "node scripts/build.js --watch",
        "build:ui": "vite build",
        "dev:ui": "vite",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit",
        "generate": "node scripts/generate-module-registry.js",
        "docker:up": "docker compose -f docker/docker-compose.yml up -d",
        "docker:down": "docker compose -f docker/docker-compose.yml down",
        "docker:logs": "docker compose -f docker/docker-compose.yml logs -f",
        "docker:restart": "docker compose -f docker/docker-compose.yml restart fivem"
    },
    "dependencies": {
        "@merinaa/core": "^0.3.0",
        "@merinaa/server": "^0.3.0",
        "@merinaa/client": "^0.3.0",
        "@merinaa/ui": "^0.3.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "reflect-metadata": "^0.2.2"
    },
    "devDependencies": {
        "@citizenfx/server": "latest",
        "@citizenfx/client": "latest",
        "@deepkit/type-compiler": "^1.0.19",
        "@types/node": "^22.0.0",
        "@types/react": "^18.3.0",
        "@types/react-dom": "^18.3.0",
        "@vitejs/plugin-react": "^4.3.0",
        "autoprefixer": "^10.4.20",
        "chokidar": "^4.0.0",
        "esbuild": "^0.24.0",
        "postcss": "^8.4.49",
        "tailwindcss": "^3.4.0",
        "ts-patch": "^3.3.0",
        "typescript": "^5.7.0",
        "vite": "^6.0.0",
        "vitest": "^4.1.0"
    },
    "engines": {
        "node": ">=22.0.0"
    }
}
