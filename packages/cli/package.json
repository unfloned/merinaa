{
    "name": "@merinaa/cli",
    "version": "0.4.2",
    "description": "CLI scaffolding for Merinaa — init new FiveM projects and generate modules",
    "author": "Florian Chiorean",
    "license": "MIT",
    "homepage": "https://merinaa.vercel.app",
    "repository": {
        "type": "git",
        "url": "https://github.com/unfloned/merinaa.git",
        "directory": "packages/cli"
    },
    "bugs": "https://github.com/unfloned/merinaa/issues",
    "keywords": [
        "fivem",
        "cli",
        "scaffold",
        "generator",
        "framework",
        "typescript",
        "merinaa"
    ],
    "sideEffects": false,
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "bin": {
        "merinaa": "./dist/bin.js",
        "create-merinaa": "./dist/bin-init.js"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "templates",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "tsc",
        "dev": "tsc --watch",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "kleur": "^4.1.5"
    },
    "devDependencies": {
        "@types/node": "^26.6.6",
        "typescript": "^7.0.2"
    },
    "engines": {
        "node": ">=22.0.0"
    },
    "publishConfig": {
        "access": "public"
    }
}
