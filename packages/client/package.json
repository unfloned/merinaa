{
    "name": "@merinaa/client",
    "version": "0.4.2",
    "description": "Client-side framework for FiveM with decorator-based controllers and NUI bridge",
    "author": "Florian Chiorean",
    "license": "MIT",
    "homepage": "https://merinaa.vercel.app",
    "repository": {
        "type": "git",
        "url": "https://github.com/unfloned/merinaa.git",
        "directory": "packages/client"
    },
    "bugs": "https://github.com/unfloned/merinaa/issues",
    "keywords": [
        "fivem",
        "client",
        "framework",
        "typescript",
        "decorators",
        "nui",
        "controllers",
        "merinaa"
    ],
    "sideEffects": [
        "dist/index.js"
    ],
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "tspc",
        "dev": "tspc --watch",
        "typecheck": "tspc --noEmit"
    },
    "dependencies": {
        "@merinaa/core": "workspace:*"
    },
    "peerDependencies": {
        "@citizenfx/client": "*",
        "reflect-metadata": "^0.2.0"
    },
    "peerDependenciesMeta": {
        "@citizenfx/client": {
            "optional": false
        },
        "reflect-metadata": {
            "optional": false
        }
    },
    "devDependencies": {
        "@citizenfx/client": "latest",
        "reflect-metadata": "^0.2.2",
        "typescript": "^7.0.2"
    },
    "publishConfig": {
        "access": "public"
    }
}
