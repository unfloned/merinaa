{
    "name": "@merinaa/ui",
    "version": "0.3.0",
    "description": "React-based NUI framework for FiveM — page/overlay registry, NUI hooks, reusable components",
    "author": "Florian Chiorean",
    "license": "MIT",
    "homepage": "https://merinaa.vercel.app",
    "repository": {
        "type": "git",
        "url": "https://github.com/unfloned/merinaa.git",
        "directory": "packages/ui"
    },
    "bugs": "https://github.com/unfloned/merinaa/issues",
    "keywords": [
        "fivem",
        "nui",
        "react",
        "ui",
        "typescript",
        "tailwind",
        "components",
        "merinaa"
    ],
    "type": "module",
    "sideEffects": [
        "**/*.css",
        "src/services/notification.service.ts"
    ],
    "main": "src/core/index.ts",
    "types": "src/core/index.ts",
    "exports": {
        ".": {
            "types": "./src/core/index.ts",
            "default": "./src/core/index.ts"
        },
        "./core": {
            "types": "./src/core/index.ts",
            "default": "./src/core/index.ts"
        },
        "./hooks": {
            "types": "./src/hooks/useNui.ts",
            "default": "./src/hooks/useNui.ts"
        },
        "./components": {
            "types": "./src/components/index.ts",
            "default": "./src/components/index.ts"
        },
        "./stores": {
            "types": "./src/stores/index.ts",
            "default": "./src/stores/index.ts"
        },
        "./utils": {
            "types": "./src/utils/index.ts",
            "default": "./src/utils/index.ts"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "src",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "typecheck": "tsc --noEmit -p tsconfig.json"
    },
    "dependencies": {
        "@hugeicons/core-free-icons": "^3.1.1",
        "@hugeicons/react": "^1.1.4",
        "clsx": "^2.1.1",
        "lucide-react": "^0.460.0",
        "zustand": "^5.0.0"
    },
    "peerDependencies": {
        "react": "^18.0.0 || ^19.0.0",
        "react-dom": "^18.0.0 || ^19.0.0"
    },
    "devDependencies": {
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.1",
        "autoprefixer": "^10.4.20",
        "postcss": "^8.5.12",
        "react": "^19.2.5",
        "react-dom": "^19.2.5",
        "tailwindcss": "^4.2.4",
        "typescript": "^6.0.3",
        "vite": "^8.0.10"
    },
    "publishConfig": {
        "access": "public"
    }
}
