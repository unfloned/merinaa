{
    "name": "merinaa-monorepo",
    "version": "0.1.0",
    "private": true,
    "description": "Merinaa — a modular TypeScript framework for FiveM servers",
    "author": "Florian Chiorean",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/unfloned/merinaa.git"
    },
    "homepage": "https://github.com/unfloned/merinaa#readme",
    "bugs": "https://github.com/unfloned/merinaa/issues",
    "keywords": [
        "fivem",
        "framework",
        "typescript",
        "decorators",
        "dependency-injection",
        "nui",
        "react"
    ],
    "scripts": {
        "build": "pnpm --filter \"@merinaa/*\" -r build",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "eslint \"packages/**/*.ts\"",
        "typecheck": "pnpm --filter @merinaa/core build && pnpm --filter \"@merinaa/*\" -r typecheck"
    },
    "devDependencies": {
        "@citizenfx/client": "latest",
        "@citizenfx/server": "latest",
        "@deepkit/type-compiler": "^1.1.0",
        "@types/node": "^26.6.6",
        "@vitest/ui": "^5.1.0",
        "esbuild": "^0.28.2",
        "eslint": "^10.14.0",
        "prettier": "^3.9.10",
        "reflect-metadata": "^0.2.2",
        "rimraf": "^6.1.4",
        "ts-node": "^10.9.2",
        "ts-patch": "^4.0.1",
        "typescript": "^7.0.2",
        "vitest": "^5.1.0",
        "yaml": "^2.9.1"
    },
    "engines": {
        "node": ">=22.0.0"
    }
}
